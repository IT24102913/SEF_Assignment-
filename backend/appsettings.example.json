{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=healthbridge_db;Username=postgres;Password=your_password_here"
  },
  "JwtSettings": {
    "Secret": "ReplaceWithAStrongSecretKeyAtLeast32CharactersLong!",
    "Issuer": "HealthBridgeApi",
    "Audience": "HealthBridgeClients",
    "ExpiryInMinutes": 1440
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-2.5-flash",
    "TimeoutSeconds": 8,
    "TotalBudgetSeconds": 12,
    "MaxRetries": 2
  },
  "DoctorRecommendation": {
    "ConfidenceThreshold": 0.6,
    "TimeoutSeconds": 8,
    "GeminiModel": "gemini-2.5-flash",
    "ApprovalValidityHours": 24,
    "MaxRevisions": 3
  }
}
